<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="#F7F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FOTON POLE KAMERA"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#174A5B" />

        <Button
            android:id="@+id/poleButtonCrawler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRAWLER" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Video: hat/bilgiler • Fotoğraf: distance • Eşleşme: GPS + saat"
        android:textSize="13sp"
        android:textColor="#4B5563" />

    <Button
        android:id="@+id/poleButtonFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="VİDEO + FOTOĞRAF KLASÖRÜ SEÇ" />

    <TextView
        android:id="@+id/poleTextFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Klasör seçilmedi"
        android:textColor="#6B7280"
        android:maxLines="2" />

    <Button
        android:id="@+id/poleButtonMonitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="OTOMATİK TAKİBİ BAŞLAT" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/poleButtonStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="DURDUR" />

        <Button
            android:id="@+id/poleButtonChangeFolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginStart="6dp"
            android:text="KLASÖR DEĞİŞTİR" />
    </LinearLayout>

    <Button
        android:id="@+id/poleButtonScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="KLASÖRÜ TOPLU TARA" />

    <ProgressBar
        android:id="@+id/poleProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/poleTextStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Hazır"
        android:textColor="#374151" />

    <TextView
        android:id="@+id/poleTextTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="TOPLAM: 0,00 m"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#174A5B" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/poleResultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="7dp">

        <Button
            android:id="@+id/poleButtonExcel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="EXCEL OLUŞTUR" />

        <Button
            android:id="@+id/poleButtonShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:enabled="false"
            android:text="PAYLAŞ" />
    </LinearLayout>

</LinearLayout>
