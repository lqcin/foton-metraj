<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F7F8FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FOTON CRAWLER METRAJ"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#174A5B" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Metraj = |son sayaç − ilk sayaç|"
        android:textSize="14sp"
        android:textColor="#4B5563" />

    <EditText
        android:id="@+id/editFirma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Firma adı (ör. LEDA)"
        android:inputType="textCapWords"
        android:singleLine="true" />

    <EditText
        android:id="@+id/editTarih"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tarih (GG.AA.YYYY)"
        android:inputType="text"
        android:singleLine="true" />

    <Button
        android:id="@+id/buttonFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="VİDEO KLASÖRÜ SEÇ" />

    <TextView
        android:id="@+id/textFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Klasör seçilmedi"
        android:textColor="#6B7280"
        android:maxLines="2" />

    <Button
        android:id="@+id/buttonMonitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="OTOMATİK TAKİBİ BAŞLAT" />

    <Button
        android:id="@+id/buttonAnalyze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="KLASÖRÜ TOPLU ANALİZ ET" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Hazır"
        android:textColor="#374151" />

    <TextView
        android:id="@+id/textTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="TOPLAM: 0,00 m"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#174A5B" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/buttonExcel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="EXCEL OLUŞTUR" />

        <Button
            android:id="@+id/buttonShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:enabled="false"
            android:text="PAYLAŞ" />
    </LinearLayout>

</LinearLayout>
